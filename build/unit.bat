@echo off
rem ============================================================================
rem  unit.bat - compile and run the zero-dependency C# unit tests.
rem  ASCII-only on purpose: cmd.exe mangles non-ASCII batch files.
rem
rem  Toolchain: in-box csc.exe (.NET Framework 4.x) - no third-party test
rem  framework. The test sources live in tests\UnitTests.cs and are compiled
rem  together with the product sources so this also acts as a full-project
rem  compile check.
rem
rem  Exit code: 0 when every assertion passes, non-zero otherwise.
rem ============================================================================
setlocal EnableDelayedExpansion

pushd "%~dp0.."
set "ROOT=%CD%"
popd

set "SRC=%ROOT%\src"
set "TESTS=%ROOT%\tests"
set "WORK=%ROOT%\build\work"
set "OUT=%WORK%\UnitTests.exe"

set "CSC=%WINDIR%\Microsoft.NET\Framework64\v4.0.30319\csc.exe"
if not exist "%CSC%" set "CSC=%WINDIR%\Microsoft.NET\Framework\v4.0.30319\csc.exe"

if not exist "%WORK%" mkdir "%WORK%"

echo.
echo ============================================================
echo  Claude Code installer - unit tests
echo ============================================================

rem ---------------------------------------------------------------- step 1 ----
if not exist "%CSC%" (
  echo  ERROR: csc.exe not found - .NET Framework 4.x is required.
  exit /b 1
)
if not exist "%TESTS%\UnitTests.cs" (
  echo  ERROR: %TESTS%\UnitTests.cs missing.
  exit /b 1
)
echo  csc: %CSC%

rem BuildInfo.cs is generated by build.bat and is not tracked by git. When it is
rem absent (e.g. a fresh clone / CI), generate a harmless stub so the unit tests
rem stay self-sufficient. The tested logic does not depend on its values.
set "BI=%SRC%\BuildInfo.cs"
if not exist "%BI%" (
  rem  Delayed expansion (!BI!) is mandatory here: %BI% inside a parenthesised
  rem  block is expanded once, when the whole block is parsed, so it would still
  rem  hold the OLD value (src\BuildInfo.cs) and the stub would be written into
  rem  the source tree, then the compile step would fail with CS2001 on the new
  rem  path. That only shows up in a fresh clone (no src\BuildInfo.cs).
  set "BI=%WORK%\BuildInfo.stub.cs"
  echo  NOTE: %SRC%\BuildInfo.cs missing - generating a stub for the unit build.
  >  "!BI!" echo namespace ClaudeCodeSetup
  >> "!BI!" echo {
  >> "!BI!" echo     internal static class BuildInfo
  >> "!BI!" echo     {
  >> "!BI!" echo         internal const string ReleaseVersion = "0.0.0";
  >> "!BI!" echo         internal const string ReleaseTag     = "v0.0.0";
  >> "!BI!" echo         internal const string AssetName      = "claude-win32-x64.zip";
  >> "!BI!" echo         internal const string ReleaseUrl     = "";
  >> "!BI!" echo         internal const string PayloadSha256  = "";
  >> "!BI!" echo         internal const string BinarySha256   = "";
  >> "!BI!" echo         internal const string Arm64AssetName = "claude-win32-arm64.zip";
  >> "!BI!" echo         internal const string Arm64Sha256    = "";
  >> "!BI!" echo     }
  >> "!BI!" echo }
)

rem ---------------------------------------------------------------- step 2 ----
echo.
echo  Compiling unit tests (all product sources + tests\UnitTests.cs)...
rem  Program.cs and Uninstaller.cs each declare a Main; /main selects the test
rem  entry point. WinForms/Drawing refs are needed because the product sources
rem  are compiled in full.
"%CSC%" /nologo /target:exe /platform:anycpu /codepage:65001 ^
  /out:"%OUT%" /main:ClaudeCodeSetup.UnitTests ^
  /nowarn:0649 ^
  /r:System.dll /r:System.Drawing.dll /r:System.Windows.Forms.dll ^
  /r:System.IO.Compression.dll /r:System.IO.Compression.FileSystem.dll ^
  "%SRC%\Program.cs" "%SRC%\MainForm.cs" "%SRC%\Checks.cs" "%SRC%\Installer.cs" ^
  "%SRC%\Uninstaller.cs" "%SRC%\Common.cs" "%BI%" "%TESTS%\UnitTests.cs"
if errorlevel 1 (
  echo  ERROR: unit test compilation failed.
  exit /b 1
)
echo  ok: %OUT%

rem ---------------------------------------------------------------- step 3 ----
echo.
"%OUT%"
set "RC=%ERRORLEVEL%"

echo.
echo ============================================================
if "%RC%"=="0" (
  echo  UNIT RESULT: PASS
) else (
  echo  UNIT RESULT: FAIL
)
echo ============================================================
exit /b %RC%
